{
  "name": "cloud-2",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "bun --env-file=.env ./node_modules/.bin/prisma generate",
    "db:push": "bun --env-file=.env ./node_modules/.bin/prisma db push",
    "db:migrate": "bun --env-file=.env ./node_modules/.bin/prisma migrate dev",
    "db:seed": "bun --env-file=.env ./node_modules/.bin/prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@nuxt/ui": "^4.7.1",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "dotenv": "^17.2.3",
    "nuxt": "^4.3.1",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@types/node": "^24.3.0",
    "prisma": "^7.4.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  }
}
